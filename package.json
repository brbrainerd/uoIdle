{
  "name": "uo-idle-kb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract:bundle": "node tools/bundle_extract.mjs",
    "verify:bundle": "node tools/bundle_extract.mjs --verify",
    "build:kb": "python3 mechanics/tools/kb.py build --root mechanics",
    "verify:kb": "python3 mechanics/tools/kb.py --self-test && python3 mechanics/tools/kb.py check --root mechanics",
    "verify:skills": "npx tsx tools/validate_skills.ts --verify",
    "build:sim": "npx tsx tools/sim_balance.ts --parity --write-parity",
    "verify:sim": "npx tsx tools/sim_balance.ts --verify",
    "test:sim": "npx tsx tools/test_sim.ts",
    "verify:icons": "python3 tools/generate_icons.py --verify",
    "build:mockups": "npx tsx tools/build_mockups.ts",
    "verify:mockups": "npx tsx tools/build_mockups.ts --verify",
    "verify:all": "npm run verify:kb && npm run verify:skills && npm run verify:sim && npm run test:sim && npm run verify:icons && npm run verify:mockups"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "zod": "^3.24.0"
  }
}
