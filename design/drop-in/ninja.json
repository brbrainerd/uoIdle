  "progression": [
    {
      "level": 1,
      "id": "ninja_shadowjump",
      "nameEn": "Shadowjump",
      "namePtBr": "Salto das Sombras",
      "type": "passive",
      "descEn": "Melt into the seams of twilight and reappear behind your prey between heartbeats. Innate Ninjitsu shadow-step footwork and high-speed Fencing auto-attack mastery with Kryss, Tekagi, Kama, and Sai that primes stealth openers on each new target.",
      "descPtBr": "Dissolva-se nas frestas do crepúsculo e ressurja atrás da presa entre um batimento e outro. Passo das sombras inato de Ninjitsu e maestria de ataque automático veloz de Esgrima com Kryss, Tekagi, Kama e Sai que prepara aberturas furtivas.",
      "inCatalog": true,
      "catalogId": "ninja_shadowjump"
    },
    {
      "level": 5,
      "id": "ninja_focus",
      "nameEn": "Focus Attack",
      "namePtBr": "Ataque Focado",
      "type": "skill",
      "descEn": "Condense all of your Ninjitsu ki into the needle-point of a shieldless blade. Strikes for 1.15x-1.25x Ninjitsu damage (1 + Ninjitsu^2/43,636), amplifies weapon proc properties, and staggers the target's radial nerves for 3s.",
      "descPtBr": "Condense todo o seu ki Ninjitsu na ponta de agulha de uma lâmina sem escudo. Golpeia causando 1.15x-1.25x de dano Ninjitsu (1 + Ninjitsu^2/43.636), amplifica propriedades da arma e paralisa os nervos do alvo por 3s.",
      "inCatalog": true,
      "catalogId": "ninja_focus"
    },
    {
      "level": 10,
      "id": "ninja_mirror",
      "nameEn": "Mirror Image",
      "namePtBr": "Imagem Espelhada",
      "type": "spell",
      "descEn": "Weave a living illusion of smoke and moonlight that mimics your every stance. Summons an ablative shadow clone reducing damage taken by 8% for 6s in Mode A and intercepting incoming melee blows (Ninjitsu / 150 chance) in Mode B.",
      "descPtBr": "Teça uma ilusão viva de fumaça e luar que espelha cada postura sua. Conjura um clone sombrio ablativo reduzindo o dano sofrido em 8% por 6s no Modo A e desviando golpes corpo a corpo (chance Ninjitsu / 150) no Modo B.",
      "inCatalog": true,
      "catalogId": "ninja_mirror"
    },
    {
      "level": 15,
      "id": "ninja_backstab",
      "nameEn": "Backstab",
      "namePtBr": "Punhalada pelas Costas",
      "type": "skill",
      "descEn": "Lunge from the blind spot where armor plates meet, driving steel deep into vital arteries. Delivers a 1.15x-1.25x Ninjitsu ambush strike (scaled by Hiding and Stealth) and opens a 5s Shadow Ambush window (+6% all damage dealt).",
      "descPtBr": "Avance pelo ponto cego onde as placas de armadura se encontram, cravando o aço em artérias vitais. Desfere uma emboscada de 1.15x-1.25x de dano Ninjitsu e abre uma janela de Emboscada Sombria de 5s (+6% de dano causado).",
      "inCatalog": true,
      "catalogId": "ninja_backstab"
    },
    {
      "level": 20,
      "id": "ninja_death",
      "nameEn": "Death Strike",
      "namePtBr": "Golpe Mortal",
      "type": "skill",
      "descEn": "Strike the forbidden dim-mak meridian—the victim feels only a chill until their heart falters five beats later. Plants a lethal Ninjitsu Death Mark that ticks over 4s of internal trauma in Mode A or detonates for massive unmitigated damage on your 5th swing in Mode B.",
      "descPtBr": "Atinja o meridiano proibido dim-mak—a vítima sente apenas um calafrio até o coração falhar cinco golpes depois. Planta a Marca da Morte Ninjitsu que pulsa por 4s no Modo A ou detona em dano puro devastador no 5º ataque conectado no Modo B.",
      "inCatalog": true,
      "catalogId": "ninja_death"
    },
    {
      "level": 25,
      "id": "ninja_animal_form",
      "nameEn": "Animal Form",
      "namePtBr": "Forma Animal",
      "type": "spell",
      "descEn": "Invoke the primal totems of Tokuno's mist-shrouded forests without sheathing your blades. Channels the Kitsune & Grey Wolf Predator Aspect for 8s: grants +10% Attack Speed, +3% Evasion instinct, and unleashes a Fox-Fire Spirit Claw on every 3rd Fencing swing.",
      "descPtBr": "Invoque os totens primordiais das florestas nebulosas de Tokuno sem embainhar suas armas. Canaliza o Aspecto Predador de Kitsune e Lobo Cinzento por 8s: concede +10% de Velocidade de Ataque, +3% de Evasão e dispara Garra Espiritual a cada 3º ataque.",
      "inCatalog": true,
      "catalogId": "ninja_animal_form"
    },
    {
      "level": 30,
      "id": "ninja_infectious_strike",
      "nameEn": "Infectious Strike",
      "namePtBr": "Golpe Infeccioso",
      "type": "skill",
      "descEn": "Draw the wavy serpentine edge of your Kryss across a hidden reservoir of nightshade and sea-serpent bile. Inflicts 0.90x-1.00x Fencing damage and injects a virulent 3-tick assassin venom over 6s with zero potion consumption.",
      "descPtBr": "Deslize a lâmina sinuosa do Kryss por um reservatório oculto de beladona e bile de serpente marinha. Causa 0.90x-1.00x de dano de Esgrima e injeta um veneno virulento de 3 pulsos ao longo de 6s sem consumir poções.",
      "inCatalog": true,
      "catalogId": "ninja_infectious_strike"
    },
    {
      "level": 35,
      "id": "ninja_smoke_bomb",
      "nameEn": "Smoke Bomb",
      "namePtBr": "Bomba de Fumaça",
      "type": "mechanic",
      "descEn": "Shatter a lacquered Tokuno flash-sphere at your feet, vanishing in a choking cloud of sulfur and ash. Triggers a 6s Vanish & Volley stealth veil (-8% damage taken), refreshes Stealth opener empowerment, and unlocks Shuriken & Fukiya volleys.",
      "descPtBr": "Estilhace uma esfera de fumaça de Tokuno aos seus pés, desaparecendo numa nuvem densa de enxofre e cinzas. Ativa um véu furtivo de 6s (-8% de dano recebido), renova aberturas furtivas e libera saraivadas de Shuriken e Fukiya.",
      "inCatalog": true,
      "catalogId": "ninja_smoke_bomb"
    },
    {
      "level": 40,
      "id": "ninja_ki_attack",
      "nameEn": "Ki Attack",
      "namePtBr": "Ataque de Ki",
      "type": "skill",
      "descEn": "Compress wind and shadow beneath your Tabi boots, vaulting across the battlefield in a single blurred flash. Closes the gap for 0.95x-1.05x Ninjitsu damage and releases an 85% kinetic ki shockwave onto an adjacent enemy.",
      "descPtBr": "Comprima vento e sombra sob suas botas Tabi, cruzando o campo de batalha num único clarão. Fecha a distância causando 0.95x-1.05x de dano Ninjitsu e libera uma onda de choque cinética de 85% em um inimigo adjacente.",
      "inCatalog": true,
      "catalogId": "ninja_ki_attack"
    },
    {
      "level": 45,
      "id": "ninja_surprise_attack",
      "nameEn": "Surprise Attack",
      "namePtBr": "Ataque Surpresa",
      "type": "skill",
      "descEn": "Strike from the smoke veil at the exact instant the enemy turns their head, shattering their defensive posture. Shreds target physical defense by -8% (and -16 to -25 Defense Chance) for 6s, leaving bosses wide open to Death Strike.",
      "descPtBr": "Golpeie a partir do véu de fumaça no exato instante em que o inimigo desvia o olhar, quebrando sua postura defensiva. Reduz a defesa física do alvo em -8% por 6s, deixando chefes vulneráveis ao Golpe Mortal.",
      "inCatalog": true,
      "catalogId": "ninja_surprise_attack"
    },
    {
      "level": 50,
      "id": "ninja_fukiya_barrage",
      "nameEn": "Fukiya & Egg Bomb Barrage",
      "namePtBr": "Barragem de Fukiya e Bomba de Ovo",
      "type": "spell",
      "descEn": "Unleash the full Tokuno shinobi arsenal: a blinding Egg Bomb (itemId: 10249) flash-cloud paired with a rapid Fukiya blowgun (itemId: 10154) poison-dart barrage. Grants -10% damage taken, +8% damage dealt, and an ablative decoy clone for 7s.",
      "descPtBr": "Libere todo o arsenal shinobi de Tokuno: uma Bomba de Ovo (10249) cegante combinada com uma barragem de dardos envenenados de Zarabatana Fukiya (10154). Concede -10% de dano recebido, +8% de dano causado e um clone de fumaça por 7s.",
      "inCatalog": true,
      "catalogId": "ninja_fukiya_barrage"
    },
    {
      "level": 60,
      "id": "ninja_twin_shadow",
      "nameEn": "Kage Bunshin: Twin Shadow Execution",
      "namePtBr": "Kage Bunshin: Execução das Sombras Gêmeas",
      "type": "feature",
      "descEn": "Forbidden Grandmaster Kage Bunshin assassination art: two living shadow clones converge from opposite blind spots to sever the target's lifeline. Deals 1.15x-1.25x damage (1.85x execute below 35% HP) and plants a 4-tick / 5-swing Twin Shadow Mark.",
      "descPtBr": "Arte proibida de Grão-Mestre Kage Bunshin: dois clones de sombra vivos convergem de ângulos opostos para ceifar a vida do alvo. Causa 1.15x-1.25x de dano (execução de 1.85x abaixo de 35% de Vida) e planta a Marca das Sombras Gêmeas.",
      "inCatalog": true,
      "catalogId": "ninja_twin_shadow"
    }
  ],
