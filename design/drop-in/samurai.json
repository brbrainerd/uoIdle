  "progression": [
    {
      "level": 1,
      "id": "samurai_way",
      "nameEn": "Way of the Blade",
      "namePtBr": "Caminho da Lâmina",
      "type": "passive",
      "descEn": "Walk the Bushido code of Tokuno: your weapon and mind become a single shieldless ward. Grants continuous auto-swing mastery and authentic Bushido Weapon Parry (Parry * Bushido / 48,000 1H or 41,140 2H) with Katana, Wakizashi, No-Dachi, and Daisho.",
      "descPtBr": "Trilhe o código Bushido de Tokuno: sua lâmina e mente tornam-se uma guarda sem escudo. Concede maestria contínua de ataque automático e Aparar de Arma Bushido autêntico (Parry * Bushido / 48.000 1M ou 41.140 2M) com Katana, Wakizashi, No-Dachi e Daisho.",
      "inCatalog": true,
      "catalogId": "samurai_way"
    },
    {
      "level": 5,
      "id": "samurai_lightning",
      "nameEn": "Lightning Strike",
      "namePtBr": "Golpe Relâmpago",
      "type": "skill",
      "descEn": "Draw your blade at the speed of a thunderbolt, striking before the foe can raise their guard. Delivers a +50 Accuracy precision slash (1.15x-1.25x) with a Bushido^2/72,000 critical IgnoreArmor roll and 3s nerve stagger.",
      "descPtBr": "Desembainhe sua espada na velocidade de um trovão antes que o inimigo erga a guarda. Desfere um corte de precisão (+50 de Acerto, 1.15x-1.25x) com chance crítica Bushido^2/72.000 de ignorar armadura e 3s de desequilíbrio.",
      "inCatalog": true,
      "catalogId": "samurai_lightning"
    },
    {
      "level": 10,
      "id": "samurai_perfection",
      "nameEn": "Honor & Perfection",
      "namePtBr": "Honra e Perfeição",
      "type": "mechanic",
      "descEn": "Pledge solemn Bushido Honor to your quarry, turning every unanswered blow into rising martial Perfection. Automatically builds consecutive-hit damage stacks (+14% Mode A window / up to +15% Mode B streak) and restores HP, Mana, and Stamina on kill.",
      "descPtBr": "Jure Honra solene de Bushido ao adversário, convertendo cada golpe certeiro em Perfeição marcial crescente. Acumula bônus de dano em acertos consecutivos (+14% Modo A / até +15% Modo B) e restaura Vida, Mana e Estamina ao abater.",
      "inCatalog": true,
      "catalogId": "samurai_perfection"
    },
    {
      "level": 15,
      "id": "samurai_honorable",
      "nameEn": "Honorable Execution",
      "namePtBr": "Execução Honrosa",
      "type": "skill",
      "descEn": "Deliver the merciful final stroke of the Samurai code when your foe wavers near death. Unleashes a decisive Bushido cut (1.35x-1.45x base, surging to 1.85x execute below 35% HP) and ignites +15% attack speed for 9s with zero failure penalty.",
      "descPtBr": "Desfira o golpe final misericordioso do código Samurai quando o inimigo vacilar. Executa um corte decisivo de Bushido (1.35x-1.45x base, subindo para 1.85x abaixo de 35% de Vida) e concede +15% de velocidade de ataque por 9s sem penalidade.",
      "inCatalog": true,
      "catalogId": "samurai_honorable"
    },
    {
      "level": 20,
      "id": "samurai_confidence",
      "nameEn": "Confidence",
      "namePtBr": "Confiança",
      "type": "spell",
      "descEn": "Exhale doubt and center your spirit in unshakable Bushido composure. Restores health on cast (15 + Bushido^2/576) and awakens Inner Calm for 6s: every parried blow restores bonus Stamina and Mana while empowering your next counter-cut.",
      "descPtBr": "Afaste a dúvida e concentre seu espírito na serenidade inabalável do Bushido. Restaura vida ao conjurar (15 + Bushido^2/576) e desperta Calma Interior por 6s: cada golpe aparado recupera Estamina e Mana extras e fortalece seu próximo corte.",
      "inCatalog": true,
      "catalogId": "samurai_confidence"
    },
    {
      "level": 25,
      "id": "samurai_counter",
      "nameEn": "Counter Attack",
      "namePtBr": "Contra-Ataque",
      "type": "spell",
      "descEn": "Read the rhythm of the enemy's steel and turn their aggression into their undoing. Strikes for 1.55x-1.65x Bushido damage, grants +18% Counter Stance damage for 7s, and unleashes an instant free retaliation swing whenever you parry.",
      "descPtBr": "Leia o ritmo do aço inimigo e transforme a agressão deles em ruína. Golpeia com 1.55x-1.65x de dano Bushido, concede +18% de dano na Postura de Contra-Ataque por 7s e desfere uma retaliação imediata gratuita ao aparar.",
      "inCatalog": true,
      "catalogId": "samurai_counter"
    },
    {
      "level": 30,
      "id": "samurai_double_strike",
      "nameEn": "Double Strike",
      "namePtBr": "Golpe Duplo",
      "type": "skill",
      "descEn": "Flow from an overhead Katana cut directly into a rising reverse slash before the enemy can recover. Signature Katana, Daisho, and Wakizashi technique that lands two rapid consecutive blows at 90% weapon damage each, accelerating Perfection.",
      "descPtBr": "Flua de um corte descendente de Katana diretamente para um corte reverso ascendente num único fôlego. Técnica clássica de Katana, Daisho e Wakizashi que aplica dois golpes rápidos consecutivos com 90% de dano cada, acelerando a Perfeição.",
      "inCatalog": true,
      "catalogId": "samurai_double_strike"
    },
    {
      "level": 35,
      "id": "samurai_evasion",
      "nameEn": "Evasion",
      "namePtBr": "Evasão",
      "type": "spell",
      "descEn": "Enter a transcendent state of sixth-sense awareness where even arcane bolts part before your blade. Amplifies Weapon Parry (1.16x-1.50x) and intercepts direct-damage spells for 5s; deflecting an attack triggers an instant 0.85x Iaido Flash Riposte.",
      "descPtBr": "Entre em um estado transcendente de sexto sentido onde até projéteis arcanos são cortados no ar. Multiplica o Aparar de Arma (1.16x-1.50x) e intercepta magias por 5s; defletir um ataque dispara um Lampejo Iaido imediato de 0.85x.",
      "inCatalog": true,
      "catalogId": "samurai_evasion"
    },
    {
      "level": 40,
      "id": "samurai_momentum_strike",
      "nameEn": "Momentum Strike",
      "namePtBr": "Golpe de Ímpeto",
      "type": "spell",
      "descEn": "Channel the full kinetic weight of your blade through the first enemy's ribs directly into a second foe beside them. Cleaves two targets with 115% transferred momentum (150% if the primary target falls) and staggers their footing for 3s.",
      "descPtBr": "Canalize todo o peso cinético da lâmina através do primeiro inimigo diretamente contra um segundo adversário ao lado. Corta dois alvos transferindo 115% de ímpeto (150% se o alvo principal cair) e desequilibra a guarda por 3s.",
      "inCatalog": true,
      "catalogId": "samurai_momentum_strike"
    },
    {
      "level": 45,
      "id": "samurai_armor_ignore",
      "nameEn": "Armor Ignore",
      "namePtBr": "Ignorar Armadura",
      "type": "skill",
      "descEn": "Slide the razor tip of your Katana through the narrow seams of plate and dragon-scale alike. Bypasses target physical resistance, shreds enemy defense by -18% for 7s, and staggers heavily armored bosses.",
      "descPtBr": "Deslize a ponta afiada da Katana pelas frestas mais estreitas de placas e escamas dracônicas. Ignora a resistência física, reduz a defesa inimiga em -18% por 7s e desequilibra chefes pesadamente blindados.",
      "inCatalog": true,
      "catalogId": "samurai_armor_ignore"
    },
    {
      "level": 50,
      "id": "samurai_frenzied_whirlwind",
      "nameEn": "Frenzied Whirlwind",
      "namePtBr": "Turbilhão Frenético",
      "type": "skill",
      "descEn": "Become the eye of a howling Tokuno steel tempest. Signature Wakizashi and Lajatang mastery (ref: 6) that lashes primary and adjacent enemies for 1.15x-1.25x Bushido damage with 50% cyclone cleave, 25% armor bypass, and kinetic stagger.",
      "descPtBr": "Torne-se o olho de uma tempestade uivante de aço de Tokuno. Maestria clássica de Wakizashi e Lajatang (ref: 6) que açoita o alvo e inimigos adjacentes com 1.15x-1.25x de dano Bushido, 50% de corte ciclônico e 25% de penetração.",
      "inCatalog": true,
      "catalogId": "samurai_frenzied_whirlwind"
    },
    {
      "level": 60,
      "id": "samurai_kensei_judgment",
      "nameEn": "Kensei: Amakura's Judgment",
      "namePtBr": "Kensei: Julgamento de Amakura",
      "type": "feature",
      "descEn": "The forbidden Grandmaster Iaijutsu stroke of Sword-Saint Amakura. Unsheathes a blinding horizon cut (1.15x-1.25x base, surging to 1.95x execute below 35% HP) and awakens Kensei Stance for 10s (+12% Attack Speed and +8% Damage).",
      "descPtBr": "O golpe proibido de Iaijutsu do Grão-Mestre e Santo da Espada Amakura. Desembainha um corte cegante no horizonte (1.15x-1.25x base, 1.95x de execução abaixo de 35% de Vida) e desperta a Postura Kensei por 10s (+12% Velocidade e +8% Dano).",
      "inCatalog": true,
      "catalogId": "samurai_kensei_judgment"
    }
  ],
